# QA environment configuration for accounts-web
# OAuth Authority: commented to use dynamic fallback based on window.location.origin
# VITE_OAUTH_AUTHORITY=<not set — uses window.location.origin at runtime>

# API URLs for QA: all go through nginx (/api/ prefix stripped before forwarding to gateway)
# Use /api so that e.g. GET /api/accounts → nginx strips /api/ → gateway /accounts
# (local dev uses Vite proxy which strips /api/command, /api/query, etc. via vite.config.ts)
VITE_COMMAND_API_URL=/api
VITE_QUERY_API_URL=/api
VITE_WORKSPACE_API_URL=/api
VITE_SUBSCRIPTION_API_URL=/api
VITE_ORG_API_URL=/api

# OAuth Configuration
VITE_OAUTH_CLIENT_ID=accounts-ui

# Other SPA URLs
VITE_SUBSCRIPTION_WEB_URL=/subscription
