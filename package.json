{
  "name": "accounts-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run typecheck && npm run typecheck:tests && vitest run",
    "test:watch": "vitest",
    "generate:api": "bash scripts/generate-api-types.sh",
    "typecheck": "npm run generate:api && tsc -p tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@accounts/error-handling-web": "file:../error-handling-web",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.16.14",
    "@mui/material": "^5.16.14",
    "@tanstack/react-query": "^5.66.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.4",
    "oidc-client-ts": "^3.0.0",
    "openapi-fetch": "^0.12.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^14.1.3",
    "react-oidc-context": "^3.0.0",
    "react-router-dom": "^6.29.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
